{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Consensus",
  "colors": {
    "primary": "#068EF1",
    "light": "#25A4FF",
    "dark": "#006FCE"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "API",
        "groups": [
          {
            "group": "References",
            "openapi": "openapi.json",
            "pages": [
              "GET /v1/search",
              "GET /v1/quick_search"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "consensus-mcp"
            ]
          }
        ]
      }
